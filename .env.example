# Copy to .env for local development. Never commit .env.
# Placeholders only. Do not put real credentials in this file.

# development | test | production
APEX_ENVIRONMENT=development

# Development RS256 bearer tokens. Refused when APEX_ENVIRONMENT=production.
# X-Apex-Principal is not accepted as identity.
APEX_DEV_AUTH_ENABLED=true

# Required together before protected routes accept tokens.
# Production must set the issuer, audience, and public key, and must not set the private key.
APEX_AUTH_ISSUER=https://apex.local/issuer
APEX_AUTH_AUDIENCE=apex-api
APEX_AUTH_PUBLIC_KEY_PEM=
APEX_AUTH_PRIVATE_KEY_PEM=
# Optional PEM files. Used only when the matching PEM setting is empty. Do not commit the files.
APEX_AUTH_PUBLIC_KEY_FILE=
APEX_AUTH_PRIVATE_KEY_FILE=

# Optional JWKS. When set, verification uses this URL and does not discover or fall back to the PEM.
# APEX_AUTH_OIDC_DISCOVERY=true fetches {APEX_AUTH_ISSUER}/.well-known/openid-configuration
# only when APEX_AUTH_JWKS_URL is empty. The issuer in the document must match APEX_AUTH_ISSUER.
# Production discovery requires an https issuer. A token cannot choose the URL.
APEX_AUTH_JWKS_URL=
APEX_AUTH_OIDC_DISCOVERY=false
APEX_AUTH_JWKS_REFRESH_SECONDS=30
APEX_AUTH_JWKS_CACHE_SECONDS=300
APEX_AUTH_JWKS_TIMEOUT_SECONDS=2
APEX_AUTH_JWKS_MAX_BYTES=65536
APEX_AUTH_JWKS_ALLOW_HTTP_FIXTURE=false

# Development token minting. Off unless both are set. Refused in production.
# The bootstrap value is compared with X-Apex-Dev-Bootstrap. It is not a credential to commit.
APEX_DEV_TOKEN_ISSUANCE=false
APEX_DEV_TOKEN_BOOTSTRAP=

# Remote MCP may use http://127.0.0.1 only outside production when this is true.
APEX_MCP_ALLOW_LOCAL_FIXTURE=false
APEX_MCP_TIMEOUT_SECONDS=5
APEX_MCP_MAX_BYTES=1000000

# Memory context budget in characters. Task memory expires after this many hours.
APEX_MEMORY_CONTEXT_BUDGET=2000
APEX_TASK_MEMORY_TTL_HOURS=168

# Secret references are env:NAME, file:NAME, or vault:path. Do not put a secret value here.
# env is for development and tests. Production with APEX_REQUIRE_EXTERNAL_SECRETS=true
# must set file or vault and does not fall back to env.
APEX_SECRET_PROVIDER=env
APEX_SECRET_DIR=
APEX_VAULT_ADDR=
APEX_VAULT_TOKEN_ENV=APEX_VAULT_TOKEN
APEX_VAULT_MOUNT=secret
APEX_SECRET_CACHE_SECONDS=30
APEX_REQUIRE_EXTERNAL_SECRETS=false

# Deleted memory is physically removed after this many hours. Backups are not rewritten.
# APEX_BACKUP_RETENTION_DAYS is the operator retention expectation, not an Apex erase.
# APEX_OPERATIONAL_RETENTION_DAYS=0 keeps task, execution, approval, and trusted context rows.
# A positive value deletes only untrusted context proposals older than that many days
# when they are not tied to an unresolved task or goal.
APEX_MEMORY_PURGE_AFTER_HOURS=24
APEX_BACKUP_RETENTION_DAYS=30
APEX_OPERATIONAL_RETENTION_DAYS=0

# Seeds dev-user, dev-restricted, dev-approver, dev-registrar, and dev-denied. Refused in production.
APEX_SEED_DEV_PRINCIPALS=true

# Local PostgreSQL from infrastructure/docker/compose.yaml.
# That development database uses the password in the URL below. It is not the deployment stack.
# infrastructure/docker/compose.deploy.yml requires APEX_POSTGRES_PASSWORD and has no default.
APEX_DATABASE_URL=postgresql+psycopg://apex:apex@localhost:5432/apex
# APEX_POSTGRES_PASSWORD=

APEX_LOG_LEVEL=INFO
APEX_MODEL_PROVIDER=mock
APEX_INSTANCE_ID=local
APEX_LEASE_SECONDS=60
APEX_APPROVAL_TTL_HOURS=24
APEX_MAX_TASK_ATTEMPTS=3
APEX_REQUEST_TIMEOUT_SECONDS=30

# Coordinated goals. These caps are ceilings. Raising them does not grant authority.
APEX_MAX_GOAL_SUBTASKS=8
APEX_MAX_PLAN_REVISIONS=3
APEX_MAX_AGENT_INVOCATIONS=12
APEX_MAX_GOAL_CONCURRENCY=2
APEX_MAX_GOAL_RECOVERIES=3
APEX_MAX_GOALS_PER_RECOVERY=4

# The supported Compose stack sets defer so the worker, not the API request, finishes a goal.
# Leave this false for the local API process, which still executes an eligible goal in the request.
APEX_DEFER_GOAL_EXECUTION=false
APEX_WORKER_HEALTH_PORT=8001
APEX_WORKER_SHUTDOWN_SECONDS=20
APEX_WORKER_INTERVAL_SECONDS=5

# Optional providers. Leave blank unless you intentionally call them.
# Tests and the default runtime use the mock provider and do not need these.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2026-10-21

# Multimodal interaction. Defaults refuse image and audio on commercial adapters.
# The mock provider used by tests already declares every modality.
APEX_MEDIA_DIR=
APEX_MEDIA_MAX_BYTES=5000000
APEX_MEDIA_MAX_PIXELS=16000000
APEX_MEDIA_MAX_EDGE=8192
APEX_MEDIA_MAX_AUDIO_SECONDS=120
APEX_MEDIA_TTL_SECONDS=3600
APEX_MEDIA_CONVERSATION_RETENTION=false
APEX_MEDIA_MAX_IMAGES=4
APEX_CORS_ORIGINS=
APEX_OPENAI_IMAGE_UNDERSTANDING=false
APEX_OPENAI_TRANSCRIPTION=false
APEX_OPENAI_TRANSCRIPTION_MODEL=
APEX_OPENAI_SPEECH=false
APEX_OPENAI_SPEECH_MODEL=
APEX_ANTHROPIC_IMAGE_UNDERSTANDING=false
